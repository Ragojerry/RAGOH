# Automatic HTTPS (Let's Encrypt) for the staging hostname, e.g. 13-48-10-20.sslip.io
{$RAGOH_HOST} {
	encode gzip
	request_body {
		max_size 25MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Map tiles (pmtiles server) and map fonts/icons, cached hard on phones.
	handle_path /tiles/* {
		header Cache-Control "public, max-age=604800"
		reverse_proxy tiles:8080
	}
	handle /map-assets/* {
		header Cache-Control "public, max-age=2592000"
		root * /srv
		file_server
	}
	handle {
		reverse_proxy api:8000
	}
}
