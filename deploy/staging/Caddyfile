# Automatic HTTPS (Let's Encrypt) for the staging hostname, e.g. 13-48-10-20.sslip.io
{$RAGOH_HOST} {
	encode gzip
	request_body {
		max_size 25MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Map tiles (pmtiles server) and map fonts/icons, cached hard on phones.
	handle_path /tiles/* {
		header Cache-Control "public, max-age=604800"
		reverse_proxy tiles:8080
	}
	handle /map-assets/* {
		header Cache-Control "public, max-age=2592000"
		root * /srv
		file_server
	}
	# API, its docs and health checks.
	@api path /api/* /docs /docs/* /redoc /openapi.json /health /version
	handle @api {
		reverse_proxy api:8000
	}
	# Supervisor web dashboard (single-page app): hashed assets cached for a year,
	# index.html never cached so a deploy is picked up immediately.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/web
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self' https://tile.openstreetmap.org https://demotiles.maplibre.org; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
