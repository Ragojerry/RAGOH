# Automatic HTTPS (Let's Encrypt) for the staging hostname, e.g. 13-48-10-20.sslip.io
{$RAGOH_HOST} {
	encode gzip
	request_body {
		max_size 25MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy api:8000
}
